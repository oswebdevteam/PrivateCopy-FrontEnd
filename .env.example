# Point the UI at a running privatecopy-server. Leave unset (or delete this
# file) to run against seeded demo fixtures with no backend.
# VITE_API_URL=http://localhost:8080

# NEAR network the wallet selector signs against. Must match the network the
# server's APP_NEAR_RPC_URL points at, since it verifies the signing key is a
# full-access key on that account.
# VITE_NEAR_NETWORK=testnet
